# SConnect Environment Configuration
# Copy to .env and modify values

# Application
APP_NAME=SConnect
APP_VERSION=1.0.0
DEBUG=true

# Database
# Local SQLite (development)
DATABASE_URL=sqlite:///./data/sconnect.db
# PostgreSQL (production) - uncomment and configure:
# DATABASE_URL=postgresql://user:password@localhost:5432/sconnect

# Security
# IMPORTANT: Generate a strong secret key for production (min 32 chars)
# Example: openssl rand -base64 32
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# Session
SESSION_MAX_AGE=2592000  # 30 days in seconds
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=false  # Set true in production (HTTPS only)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# CORS
# Comma-separated origins for development
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Production example:
# CORS_ORIGINS=["https://app.sconnect.example.com","https://sconnect.example.com"]

# Argon2 Password Hashing Parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16